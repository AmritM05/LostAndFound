# Server-only Neon PostgreSQL connection. Never prefix these two values with NEXT_PUBLIC.
DATABASE_URL=
# Must belong to a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional for Blob completion callbacks during local development; authenticated completion also verifies uploads directly.
VERCEL_BLOB_CALLBACK_URL=
# Upload policy is centralized in lib/uploadConfig.ts: 25 MB per image.
# Public browser Maps key. Restrict by Maps JavaScript API and HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Blank uses Google's documented DEMO_MAP_ID development fallback.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_CAMPUS_NAME=
NEXT_PUBLIC_CAMPUS_LAT=
NEXT_PUBLIC_CAMPUS_LNG=
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=
NEXT_PUBLIC_PICKUP_LOCATION=Campus information desk
# Optional single-line campus JSON; defaults to the bundled OSU Columbus buildings.
NEXT_PUBLIC_CAMPUS_CONFIG=
