# Server-only Neon PostgreSQL connection. Never prefix these two values with NEXT_PUBLIC.
DATABASE_URL=
# Must belong to a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional for Blob completion callbacks during local development; authenticated completion also verifies uploads directly.
VERCEL_BLOB_CALLBACK_URL=
# Upload policy is centralized in lib/uploadConfig.ts: 25 MB per image.
# Public browser Maps key. Restrict by Maps JavaScript API and HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Blank uses Google's documented DEMO_MAP_ID development fallback.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_CAMPUS_NAME=
NEXT_PUBLIC_CAMPUS_LAT=
NEXT_PUBLIC_CAMPUS_LNG=
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=
NEXT_PUBLIC_PICKUP_LOCATION=Campus information desk
# Optional single-line campus JSON; defaults to the bundled OSU Columbus buildings.
NEXT_PUBLIC_CAMPUS_CONFIG=
# Server-only staff demo credentials; never use NEXT_PUBLIC_ for these.
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=
# Optional comma-separated full application origins for custom proxies/domains.
# Vercel deployment hosts are derived automatically; loopback ports work in development.
ALLOWED_ORIGINS=

# Server-only optional Gemini integration. Off by default; a key alone is insufficient.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
MAGPIE_AI_MATCHING_ENABLED=false
# Enable BOTH flags only for synthetic reports confirmed by staff in the comparison form.
MAGPIE_AI_DEMO_MODE=false
# Optional positive weights (1–100); missing factors are omitted. JSON must stay on one line.
MAGPIE_AI_MATCHING_WEIGHTS={"Image similarity":30,"Description":20,"Brand & category":20,"Color/details":10,"Location":10,"Time":10}

# Opt-in live synthetic test; leave false during ordinary tests.
MAGPIE_RUN_LIVE_GEMINI_TEST=false
